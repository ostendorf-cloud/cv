# Copy to .env for docker compose; see .gitignore.
ADDR=:8080
ADMIN_ADDR=:8081
LOG_LEVEL=info
# The directory holding cv.de.yaml and cv.en.yaml. Required. The image
# embeds data/ at /data; use ./data when running cvd from source.
DATA_DIR=/data
# Optional: a file holding a GitHub token, and how long the GitHub data is kept.
# GITHUB_TOKEN_FILE=/run/secrets/github-token
# GITHUB_CACHE_TTL=1h

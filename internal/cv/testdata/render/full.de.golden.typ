// Generated by cv render pdf. Do not edit: change internal/cv/templates/cv.typ.tmpl.
// Every text arrives as a typst string literal argument, never as markup.
// Target: typst 0.14 (scripts/install-typst.sh). The font "Go" ships in internal/cv/templates/fonts.
//
// Composition: page one is a grid of two columns, a tinted sidebar (photo,
// name, contact, languages, skills) beside the first section of the main
// column. Every later section flows below the grid at full width.
#let ink = rgb("#1e3a5f")
#let warm = rgb("#c2410c")
#let body-ink = rgb("#1f2937")
#let muted = rgb("#4b5563")
#let rule = rgb("#d1d5db")
#let panel = rgb("#eef2f7")

#set document(title: "Lebenslauf" + " " + "Simon Ostendorf", author: "Simon Ostendorf")
#set page(
  paper: "a4",
  margin: (x: 1.5cm, top: 1.2cm, bottom: 1.5cm),
  footer: context {
    set text(size: 7.5pt, fill: muted)
    grid(
      columns: (1fr, 1fr, 1fr),
      align(left, "Simon Ostendorf"),
      align(center, "Stand: November 2026"),
      align(right, str(counter(page).get().first()) + " / " + str(counter(page).final().first())),
    )
  },
)
#set text(font: "Go", size: 9pt, fill: body-ink, lang: "de")
#set par(justify: false, leading: 0.55em)

// No letter spacing and no hyphen replacement: an applicant tracking system
// reads the text layer, and tracking splits a heading into fragments while a
// replaced hyphen no longer matches a search for "E-Mail".
// TestPDFTextLayer reads the compiled PDF with pdftotext.

// A small uppercase label.
#let caps(body, fill: muted, size: 7.5pt) = text(
  size: size,
  weight: "bold",
  fill: fill,
  upper(body),
)

// A section heading: a small uppercase label over a thin full width rule. It
// sticks to what follows, so a heading never ends a page alone.
#let section(title) = block(above: 11pt, below: 7pt, sticky: true, stack(
  spacing: 4pt,
  caps(title, fill: ink, size: 8.5pt),
  line(length: 100%, stroke: 0.6pt + rule),
))

// A small outlined badge after an entry's title.
#let badge(body) = box(
  stroke: 0.6pt + muted,
  radius: 3pt,
  inset: (x: 3pt, y: 1.5pt),
  text(size: 6.5pt, weight: "bold", fill: muted, body),
)

// One timeline entry: a small accent dot in the gutter, then one line with
// the dates small and muted before the title in bold, the organisation on its
// own muted line, a gap and the description. It never breaks across a page.
#let entry(dates, title, org: none, marker: none, body: none, url: none) = {
  let head = ()
  let name = text(weight: "bold", fill: ink, title)
  if marker != none {
    name = name + h(5pt) + badge(marker)
  }
  if dates != "" {
    name = text(size: 8pt, fill: muted, dates) + h(8pt) + name
  }
  head.push(name)
  if org != none {
    head.push(text(size: 9pt, fill: muted, org))
  }
  let parts = (stack(spacing: 2.5pt, ..head),)
  if body != none {
    parts.push(text(size: 8.5pt, body))
  }
  if url != none {
    parts.push(text(size: 8.5pt, fill: ink, link(url)))
  }
  block(breakable: false, above: 0pt, below: 6pt, grid(
    columns: (9pt, 1fr),
    column-gutter: 5pt,
    pad(top: 2.5pt, circle(radius: 2.5pt, fill: warm, stroke: none)),
    stack(spacing: 3pt, ..parts),
  ))
}

// One labelled block of the sidebar. The values stand one per line.
#let side-block(name, values) = block(below: 12pt, breakable: false, stack(
  spacing: 4pt,
  caps(name, fill: ink),
  text(size: 8.5pt, values.map(v => [#v]).join(linebreak())),
))

// One skill category of the sidebar: the label in the warm accent, then the
// skill names, comma separated, highest level first. The level is not printed.
#let side-skills(name, skills) = block(below: 9pt, breakable: false, stack(
  spacing: 3.5pt,
  caps(name, fill: warm, size: 7pt),
  par(leading: 0.45em, text(size: 7.8pt, skills.join(", "))),
))

// The sidebar is a flow of separate blocks, not one stack: if it is taller
// than page one, it continues on page two instead of overflowing.
#let sidebar = pad(x: 12pt, y: 14pt, {
  block(below: 14pt, align(center, box(
    clip: true,
    radius: 1.5cm,
    width: 3cm,
    height: 3cm,
    image("portrait.jpg", width: 100%, height: 100%, fit: "cover", alt: "Simon Ostendorf"),
  )))
  block(below: 16pt, stack(
    spacing: 6pt,
    caps("Lebenslauf", fill: warm),
    text(size: 15pt, weight: "bold", fill: ink, "Simon Ostendorf"),
    text(size: 9pt, fill: muted, "Lead de"),
  ))
  side-block("Ort", ("Example Street 1, Example City", ))
  side-block("E-Mail", (link("mailto:contact@example.com", "contact@example.com"), ))
  side-block("Profile", (link("https://github.com/example", "GitHub"), ))
  side-block("Sprachen", ("English de (Fließend)", "German de (Muttersprache)", ))
  block(above: 6pt, below: 9pt, sticky: true, caps("Kenntnisse", fill: ink))
  side-skills("Programming de", ("Go de", ))
  side-skills("Cloud de", ("Kubernetes de", ))
})

#grid(
  columns: (6cm, 1fr),
  column-gutter: 16pt,
  fill: (x, y) => if x == 0 { panel } else { none },
  sidebar,
  [
#section("Berufserfahrung")
#entry("Jan. 2020 – Jan. 2022", "Engineer de", org: "Example Employer de · Example City de · Full-time de", body: "Summary one de.")

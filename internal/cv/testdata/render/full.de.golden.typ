// Generated by cv render pdf. Do not edit: change internal/cv/templates/cv.typ.tmpl.
// Every text arrives as a typst string literal argument, never as markup.
#let accent = rgb("#1f3a5f")
#let muted = rgb("#555555")

#set document(title: "Lebenslauf" + " " + "Simon Ostendorf", author: "Simon Ostendorf")
#set page(
  paper: "a4",
  margin: (x: 2cm, y: 1.8cm),
  footer: context align(center, text(size: 8pt, fill: muted)[
    #"Simon Ostendorf", #counter(page).display() / #counter(page).final().first()
  ]),
)
#set text(font: "Libertinus Serif", size: 10pt, lang: "de")
#set par(justify: false, leading: 0.6em)
#show heading.where(level: 1): it => block(above: 1.3em, below: 0.7em, width: 100%)[
  #text(size: 11.5pt, weight: "bold", fill: accent)[#it.body]
  #v(-0.5em)
  #line(length: 100%, stroke: 0.5pt + accent)
]

// One dated entry. It never breaks across a page: the date column, the title,
// the subtitle and the body stay together.
#let entry(dates, title, subtitle: none, body: none, url: none) = block(
  breakable: false,
  below: 0.9em,
  width: 100%,
)[
  #grid(
    columns: (3.4cm, 1fr),
    column-gutter: 0.6em,
    text(fill: muted)[#dates],
    [
      #text(weight: "bold")[#title]
      #if subtitle != none [ #linebreak() #subtitle ]
      #if body != none [ #linebreak() #body ]
      #if url != none [ #linebreak() #text(fill: muted)[#link(url)] ]
    ],
  )
]

// A list of name and detail pairs in two columns.
#let pairs(items) = block(below: 0.6em, width: 100%)[
  #grid(
    columns: (1fr, 1fr),
    column-gutter: 1em,
    row-gutter: 0.5em,
    ..items.map(p => [#text(weight: "bold")[#p.at(0)] #h(0.4em) #text(fill: muted)[#p.at(1)]]),
  )
]

#align(left)[

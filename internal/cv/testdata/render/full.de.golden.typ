// Generated by cv render pdf. Do not edit: change internal/cv/templates/cv.typ.tmpl.
// Every text arrives as a typst string literal argument, never as markup.
// Target: typst 0.14 (mise.toml). The font "Go" ships in internal/cv/templates/fonts.
#let accent = rgb("#0f766e")
#let ink = rgb("#111827")
#let muted = rgb("#4b5563")
#let rule = rgb("#d1d5db")
#let edge = rgb("#9ca3af")

#set document(title: "Lebenslauf" + " " + "Simon Ostendorf", author: "Simon Ostendorf")
#set page(
  paper: "a4",
  margin: (x: 1.5cm, top: 1.3cm, bottom: 1.5cm),
  footer: context {
    set text(size: 7.5pt, fill: muted)
    grid(
      columns: (1fr, 1fr, 1fr),
      align(left, "Simon Ostendorf"),
      align(center, "Stand: November 2026"),
      align(right, str(counter(page).get().first()) + " / " + str(counter(page).final().first())),
    )
  },
)
#set text(font: "Go", size: 8.8pt, fill: ink, lang: "de")
#set par(justify: false, leading: 0.48em)

// The Go font draws its hyphen almost as wide as a dash. Every hyphen prints
// as the hyphen (U+2010) of the embedded Libertinus Serif instead, in the
// surrounding size and weight. The en dash of a date range is not touched.
#show "-": text(font: "Libertinus Serif", "\u{2010}")

// A small uppercase label: the document kind, the info row, a skill category.
#let caps(body, fill: muted, size: 7pt) = text(
  size: size,
  weight: "bold",
  fill: fill,
  tracking: 0.08em,
  upper(body),
)

// A section title with a short accent underline. It sticks to what follows,
// so a title never ends a page alone.
#let section(title) = block(above: 11pt, below: 6pt, sticky: true, stack(
  spacing: 3pt,
  text(size: 10pt, weight: "bold", title),
  rect(width: 18pt, height: 2pt, fill: accent, stroke: none),
))

// A small outlined badge after an entry's title.
#let badge(body) = box(
  stroke: 0.6pt + muted,
  radius: 3pt,
  inset: (x: 3pt, y: 1.5pt),
  text(size: 6.5pt, weight: "bold", fill: muted, body),
)

// One entry: the dates in a narrow left column, the title in bold with the
// organisation muted, then a muted description. It never breaks across a page.
#let entry(dates, title, org: none, marker: none, body: none, url: none) = {
  let head = text(weight: "bold", title)
  if org != none {
    head = head + text(fill: muted, " · " + org)
  }
  if marker != none {
    head = head + h(5pt) + badge(marker)
  }
  let parts = (head,)
  if body != none {
    parts.push(text(size: 8.2pt, fill: muted, body))
  }
  if url != none {
    parts.push(text(size: 7.8pt, fill: accent, link(url)))
  }
  block(breakable: false, above: 0pt, below: 5.5pt, grid(
    columns: (2.7cm, 1fr),
    column-gutter: 8pt,
    text(size: 7.6pt, fill: muted, dates),
    stack(spacing: 3pt, ..parts),
  ))
}

// One skill as a small outlined, rounded pill. The level is not printed.
#let pill(name) = box(
  stroke: 0.6pt + edge,
  radius: 6pt,
  inset: (x: 4.5pt, y: 2.2pt),
  text(size: 7.5pt, name),
)

// One skill category: its label in the accent colour, then its pills.
#let category(name, skills) = block(breakable: false, width: 100%, stack(
  spacing: 5pt,
  caps(name, fill: accent),
  par(leading: 0.8em, skills.map(pill).join([ ])),
))

// The skill categories, two per row.
#let categories(..cats) = grid(
  columns: (1fr, 1fr),
  column-gutter: 14pt,
  row-gutter: 9pt,
  ..cats.pos(),
)

// One label and value pair of the info row. The values are joined with a
// middle dot.
#let info(name, values) = stack(
  spacing: 4pt,
  caps(name),
  text(size: 8.5pt, values.map(v => [#v]).join([ · ])),
)

#grid(
  columns: (1fr, 2.5cm),
  column-gutter: 14pt,
  align(horizon, stack(
    spacing: 7pt,
    caps("Lebenslauf", fill: accent, size: 8pt),
    text(size: 24pt, weight: "bold", "Simon Ostendorf"),
    text(size: 11.5pt, fill: muted, "Lead de"),
  )),
  box(
    clip: true,
    radius: 8pt,
    width: 2.5cm,
    height: 2.5cm,
    image("portrait.jpg", width: 100%, height: 100%, fit: "cover", alt: "Simon Ostendorf"),
  ),
)
#v(8pt)
#grid(
  columns: (1fr,) * 4,
  column-gutter: 12pt,
  info("Ort", ("Example Street 1, Example City", )),
  info("E-Mail", (link("mailto:contact@example.com", "contact@example.com"), )),
  info("Sprachen", ("English de (Fließend)", "German de (Muttersprache)", )),
  info("Profile", (link("https://github.com/example", "GitHub"), )),
)
#v(6pt)
#line(length: 100%, stroke: 0.5pt + rule)


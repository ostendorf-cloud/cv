// Generated by cv render pdf. Do not edit: change internal/cv/templates/cv.typ.tmpl.
// Every text arrives as a typst string literal argument, never as markup.
// Target: typst 0.14 (mise.toml). The font "Go" ships in internal/cv/templates/fonts.
#let accent = rgb("#0f766e")
#let ink = rgb("#111827")
#let muted = rgb("#4b5563")
#let rule = rgb("#d1d5db")
#let edge = rgb("#9ca3af")

#set document(title: "Curriculum vitae" + " " + "Simon Ostendorf", author: "Simon Ostendorf")
#set page(
  paper: "a4",
  margin: (x: 1.7cm, top: 1.5cm, bottom: 1.8cm),
  footer: context {
    set text(size: 7.5pt, fill: muted)
    grid(
      columns: (1fr, 1fr, 1fr),
      align(left, "Simon Ostendorf"),
      align(center, "As of November 2026"),
      align(right, str(counter(page).get().first()) + " / " + str(counter(page).final().first())),
    )
  },
)
#set text(font: "Go", size: 9pt, fill: ink, lang: "en")
#set par(justify: false, leading: 0.5em)

// A small uppercase label: the document kind, the info row, a skill category.
#let caps(body, fill: muted, size: 7pt) = text(
  size: size,
  weight: "bold",
  fill: fill,
  tracking: 0.08em,
  upper(body),
)

// A section title with a short accent underline. It sticks to what follows,
// so a title never ends a page alone.
#let section(title) = block(above: 14pt, below: 8pt, sticky: true, stack(
  spacing: 4pt,
  text(size: 10.5pt, weight: "bold", title),
  rect(width: 18pt, height: 2pt, fill: accent, stroke: none),
))

// A small outlined badge after an entry's title.
#let badge(body) = box(
  stroke: 0.6pt + muted,
  radius: 3pt,
  inset: (x: 3pt, y: 1.5pt),
  text(size: 6.5pt, weight: "bold", fill: muted, body),
)

// One entry: the dates in a narrow left column, the title in bold with the
// organisation muted, then a muted description. It never breaks across a page.
#let entry(dates, title, org: none, marker: none, body: none, url: none) = {
  let head = text(weight: "bold", title)
  if org != none {
    head = head + text(fill: muted, " · " + org)
  }
  if marker != none {
    head = head + h(5pt) + badge(marker)
  }
  let parts = (head,)
  if body != none {
    parts.push(text(size: 8.5pt, fill: muted, body))
  }
  if url != none {
    parts.push(text(size: 8pt, fill: accent, link(url)))
  }
  block(breakable: false, above: 0pt, below: 8pt, grid(
    columns: (2.9cm, 1fr),
    column-gutter: 10pt,
    text(size: 8pt, fill: muted, dates),
    stack(spacing: 4pt, ..parts),
  ))
}

// One skill as a small outlined, rounded pill. The level is not printed.
#let pill(name) = box(
  stroke: 0.6pt + edge,
  radius: 6pt,
  inset: (x: 4.5pt, y: 2.2pt),
  text(size: 7.5pt, name),
)

// One skill category: its label in the accent colour, then its pills.
#let category(name, skills) = block(breakable: false, width: 100%, stack(
  spacing: 6pt,
  caps(name, fill: accent),
  par(leading: 0.85em, skills.map(pill).join([ ])),
))

// The skill categories, two per row.
#let categories(..cats) = grid(
  columns: (1fr, 1fr),
  column-gutter: 16pt,
  row-gutter: 12pt,
  ..cats.pos(),
)

// One label and value pair of the info row. The values are joined with a
// middle dot.
#let info(name, values) = stack(
  spacing: 4pt,
  caps(name),
  text(size: 8.5pt, values.map(v => [#v]).join([ · ])),
)

#grid(
  columns: (1fr, 2.7cm),
  column-gutter: 14pt,
  align(horizon, stack(
    spacing: 7pt,
    caps("Curriculum vitae", fill: accent, size: 8pt),
    text(size: 24pt, weight: "bold", "Simon Ostendorf"),
    text(size: 11.5pt, fill: muted, "Lead en"),
  )),
  box(
    clip: true,
    radius: 8pt,
    width: 2.7cm,
    height: 2.7cm,
    image("portrait.jpg", width: 100%, height: 100%, fit: "cover", alt: "Simon Ostendorf"),
  ),
)
#v(10pt)
#grid(
  columns: (1fr,) * 4,
  column-gutter: 12pt,
  info("Location", ("Example City", )),
  info("Email", (link("mailto:contact@example.com", "contact@example.com"), )),
  info("Languages", ("English en (Fluent)", "German en (Native)", )),
  info("Profiles", (link("https://github.com/example", "GitHub"), )),
)
#v(8pt)
#line(length: 100%, stroke: 0.5pt + rule)

